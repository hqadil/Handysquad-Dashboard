# .env.example - Handy Squad Complaint Management & Operations Platform

# ==============================================================================
# 1. Supabase PostgreSQL Database URLs
# In Supabase Project Settings -> Database -> Connection string:
# ==============================================================================
# Connection Pooling URL (Transaction mode, port 6543) - used by app at runtime
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URL (Session mode, port 5432) - used by migrations
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# 2. Supabase API & Private Storage Configuration
# Project Settings -> API
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Private Bucket Name for Complaint Evidence & Audio/Video Vault (Section 6)
SUPABASE_STORAGE_BUCKET="complaint-evidence"

# Signed URL Expiry Duration in Seconds (Default: 3600s / 1 hour)
SUPABASE_SIGNED_URL_EXPIRY=3600

# ==============================================================================
# 3. Regional Operational Timezone & Localization
# ==============================================================================
TZ="Asia/Kolkata"
NEXT_PUBLIC_DEFAULT_CITY="Kochi"

# ==============================================================================
# 4. Authentication & Security Secrets
# ==============================================================================
NEXTAUTH_SECRET="generate-a-secure-32-char-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Administrative & Role Seed Accounts
ADMIN_EMAIL="admin@handysquad.com"
ADMIN_PASSWORD="ChangeMeInProduction123!"

OPERATIONS_EMAIL="ops@handysquad.com"
OPERATIONS_PASSWORD="ChangeMeInProduction123!"

COO_EMAIL="coo@handysquad.com"
COO_PASSWORD="ChangeMeInProduction123!"
